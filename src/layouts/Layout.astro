---
export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Síndico Inteligente - Modernize seu condomínio em 7 dias | R$ 37',
  description = 'O guia prático que mostra como modernizar a segurança do seu condomínio sem cair em ciladas de fornecedor. Ebook + 2 bônus por R$ 37.',
  ogImage = '/og-image.jpg',
} = Astro.props;

const PIXEL_ID = '1013792507659589';
const PRODUCT_ID = 'C105540565G';
const PRICE = 37.0;
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#0a1628" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site).toString()} />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(ogImage, Astro.site).toString()} />

    <!-- Fonts (preconnect + single stylesheet load) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- Meta Pixel -->
    <script is:inline define:vars={{ PIXEL_ID }}>
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');

      window.fbq('init', PIXEL_ID);
      window.fbq('track', 'PageView');

      // ViewContent imediato (sem delay) — Maxxima Fase 1 precisa de sinal rápido
      window.fbq('track', 'ViewContent', {
        content_name: 'Síndico Inteligente',
        content_category: 'Ebook + Apresentação + Checklist',
        content_ids: [PRODUCT_ID],
        content_type: 'product',
        value: PRICE,
        currency: 'BRL',
      });

      // gera/recupera event_id estável por sessão para dedup com CAPI server-side
      function siEventId() {
        try {
          var k = 'si_ic_evt';
          var v = sessionStorage.getItem(k);
          if (!v) {
            v = 'ic_' + Date.now() + '_' + Math.random().toString(36).slice(2, 10);
            sessionStorage.setItem(k, v);
          }
          return v;
        } catch (e) {
          return 'ic_' + Date.now();
        }
      }

      // InitiateCheckout — usa sendBeacon antes do redirect pra não perder evento em mobile
      window.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll('[data-cta="checkout"]').forEach(function (btn) {
          btn.addEventListener('click', function () {
            var eventID = siEventId();
            window.fbq('track', 'InitiateCheckout', {
              content_name: 'Síndico Inteligente',
              content_ids: [PRODUCT_ID],
              content_type: 'product',
              value: PRICE,
              currency: 'BRL',
              num_items: 1,
            }, { eventID: eventID });

            try {
              if (navigator.sendBeacon) {
                var body = new URLSearchParams({
                  id: PIXEL_ID,
                  ev: 'InitiateCheckout',
                  cd: JSON.stringify({ value: PRICE, currency: 'BRL', content_ids: [PRODUCT_ID] }),
                  eid: eventID,
                });
                navigator.sendBeacon('https://www.facebook.com/tr/?' + body.toString());
              }
            } catch (e) {}
          });
        });
      });
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${PIXEL_ID}&ev=PageView&noscript=1`}
      />
    </noscript>

    <!-- Structured Data - Product -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Product',
      name: 'Síndico Inteligente',
      description: 'Guia prático com 8 capítulos + 2 bônus para modernizar a segurança eletrônica do seu condomínio em 7 dias, sem cair em ciladas de fornecedor.',
      brand: { '@type': 'Brand', name: 'Anderson Cruz' },
      offers: {
        '@type': 'Offer',
        price: '37.00',
        priceCurrency: 'BRL',
        availability: 'https://schema.org/InStock',
        url: 'https://pay.hotmart.com/C105540565G?checkoutMode=2',
      },
    })} />

    <!-- UTMify - Tracking de UTMs e atribuição de vendas -->
    <script
      src="https://cdn.utmify.com.br/scripts/utms/latest.js"
      data-utmify-prevent-subids
      async
      defer
    ></script>

    <!-- UTMify Pixel — eventos Initiate Checkout/Purchase server-side -->
    <script is:inline>
      window.pixelId = "69eeb3dfa24656f95784cafc";
      var a = document.createElement("script");
      a.setAttribute("async", "");
      a.setAttribute("defer", "");
      a.setAttribute("src", "https://cdn.utmify.com.br/scripts/pixel/pixel.js");
      document.head.appendChild(a);
    </script>
  </head>
  <body class="bg-white text-navy-900 font-sans antialiased selection:bg-teal-200 selection:text-navy-900">
    <slot />

    <style is:global>
      html {
        -webkit-tap-highlight-color: transparent;
      }
      body {
        font-feature-settings: 'cv11', 'ss01';
      }
      .font-display {
        font-family: 'Plus Jakarta Sans', Inter, system-ui, sans-serif;
        letter-spacing: -0.02em;
      }
      .gradient-navy {
        background: linear-gradient(135deg, #0a1628 0%, #162d4a 50%, #0a1628 100%);
      }
      .text-gradient-teal {
        background: linear-gradient(90deg, #14b8a6 0%, #5eecc9 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      .btn-glow {
        box-shadow: 0 10px 25px -5px rgba(20, 184, 166, 0.35), 0 6px 10px -4px rgba(250, 204, 21, 0.15);
      }
      .btn-glow:hover {
        box-shadow: 0 20px 35px -5px rgba(20, 184, 166, 0.5), 0 10px 15px -4px rgba(250, 204, 21, 0.25);
      }
    </style>
  </body>
</html>
