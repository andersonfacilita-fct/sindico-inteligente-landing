---
import CTAButton from './CTAButton.astro';

const items = [
  {
    icon: '📘',
    badge: 'Cartilha',
    title: 'Síndico Inteligente',
    subtitle: 'leitura rápida',
    description: 'O método em 4 pilares completo, em linguagem de síndico (não de técnico). Você lê em 15 minutos no celular e já sai aplicando.',
    features: [
      '5 erros que destroem a segurança do prédio',
      '4 pilares para blindar o condomínio',
      'Os 3 ângulos cegos que quase todo prédio tem',
      'O que perguntar pra empresa de CFTV',
    ],
  },
  {
    icon: '✅',
    badge: 'Checklist',
    title: 'Checklist 4 Pilares',
    subtitle: 'inspeção em 15 min',
    description: 'Vai com você na vistoria. Marca o que está OK e o que precisa ajustar — perímetro, câmeras, acesso, contingência. Vira relatório pra reunião do condomínio.',
    features: [
      'Roteiro de inspeção passo a passo',
      'Pontos críticos por área do prédio',
      'Tabela de prioridade (urgente / médio / leve)',
      'Modelo de orçamento pra fornecedor',
    ],
    highlight: true,
  },
  {
    icon: '🛡️',
    badge: 'Bônus',
    title: 'Guia de Contingência',
    subtitle: 'plano B em emergências',
    description: 'O que fazer quando faltar luz, quando a câmera parar de gravar, quando alguém invadir. Procedimento de 3 passos pra cada cenário, pronto pra colar na portaria.',
    features: [
      'Falha de energia: 3 ações imediatas',
      'CFTV fora do ar: como proceder',
      'Tentativa de invasão: protocolo',
      'Comunicado modelo pros moradores',
    ],
  },
];

---

<section class="bg-white py-16 sm:py-20 lg:py-24">
  <div class="mx-auto max-w-6xl px-5">
    <div class="text-center mb-10 sm:mb-14">
      <div class="inline-block text-xs font-bold text-teal-600 uppercase tracking-widest mb-3">
        Pacote completo
      </div>
      <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-extrabold text-navy-900 leading-tight mb-4">
        O que você <span class="text-gradient-teal">recebe</span>
      </h2>
      <p class="text-base sm:text-lg text-navy-700 max-w-2xl mx-auto">
        3 materiais que se complementam pra você tirar a segurança do condomínio do amador sem precisar de técnico.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
      {items.map((item) => (
        <div class={`relative rounded-2xl p-6 sm:p-7 shadow-lg hover:shadow-2xl transition-all duration-300 ${item.highlight ? 'bg-gradient-to-br from-teal-500 to-teal-700 text-white ring-4 ring-gold-400/40 md:-translate-y-4' : 'bg-navy-50 border border-navy-100 text-navy-900'}`}>
          {item.highlight && (
            <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-gold-400 text-navy-900 text-xs font-extrabold uppercase tracking-wider px-3 py-1 rounded-full shadow">
              Carro-chefe
            </div>
          )}

          <div class="text-5xl mb-3">{item.icon}</div>

          <div class={`text-xs font-bold uppercase tracking-widest mb-1 ${item.highlight ? 'text-gold-300' : 'text-teal-600'}`}>
            {item.badge} - {item.subtitle}
          </div>

          <h3 class={`font-display text-xl sm:text-2xl font-extrabold mb-3 ${item.highlight ? 'text-white' : 'text-navy-900'}`}>
            {item.title}
          </h3>

          <p class={`text-sm sm:text-base leading-relaxed mb-5 ${item.highlight ? 'text-teal-50' : 'text-navy-700'}`}>
            {item.description}
          </p>

          <ul class="space-y-2">
            {item.features.map((feature) => (
              <li class="flex items-start gap-2 text-sm">
                <svg class={`h-5 w-5 flex-shrink-0 mt-0.5 ${item.highlight ? 'text-gold-300' : 'text-teal-600'}`} fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                <span class={item.highlight ? 'text-white' : 'text-navy-800'}>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- BONUS: Comunidade VIP -->
    <div class="mt-10 sm:mt-14 max-w-3xl mx-auto">
      <div class="relative rounded-2xl p-6 sm:p-8 bg-gradient-to-br from-teal-600 to-teal-800 text-white shadow-2xl overflow-hidden">
        <div class="absolute -top-8 -right-8 h-40 w-40 rounded-full bg-white/10 blur-2xl"></div>
        <div class="absolute -top-3 left-6 bg-gold-400 text-navy-900 text-[11px] font-extrabold uppercase tracking-widest px-3 py-1 rounded-full shadow">
          🎁 Bônus exclusivo
        </div>

        <div class="relative grid grid-cols-1 sm:grid-cols-[auto_1fr_auto] gap-5 sm:gap-6 items-center mt-3">
          <div class="flex-shrink-0 mx-auto sm:mx-0">
            <div class="flex h-16 w-16 sm:h-20 sm:w-20 items-center justify-center rounded-2xl bg-white/15 backdrop-blur">
              <svg class="h-10 w-10 sm:h-12 sm:w-12 text-white" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
            </div>
          </div>

          <div class="text-center sm:text-left">
            <h3 class="font-display text-xl sm:text-2xl font-extrabold mb-1">
              Comunidade de Síndicos
            </h3>
            <p class="text-sm sm:text-base text-white/95 leading-relaxed">
              Grupo exclusivo de síndicos pra trocar experiências, comparar fornecedores, tirar dúvidas comigo e ver casos reais de outros prédios. Você não vai estar sozinho na vistoria.
            </p>
          </div>

          <div class="text-center sm:text-right">
            <div class="text-[11px] uppercase tracking-widest text-white/70 font-bold">Valor</div>
            <div class="font-display text-2xl sm:text-3xl font-extrabold line-through opacity-80">R$ 90</div>
            <div class="text-xs font-bold uppercase tracking-wider text-gold-300">Grátis pra você</div>
          </div>
        </div>

        <div class="relative mt-5 text-center sm:text-left">
          <p class="text-xs sm:text-sm text-white/85 italic">
            🔒 Acesso exclusivo: o link da comunidade chega no e-mail logo após sua compra ser aprovada.
          </p>
        </div>
      </div>
    </div>

    <!-- Value stack -->
    <div class="mt-10 sm:mt-14 max-w-2xl mx-auto bg-navy-50 rounded-2xl p-6 sm:p-8 border border-navy-100">
      <h3 class="font-display text-lg sm:text-xl font-bold text-navy-900 mb-5 text-center">Valor real do pacote</h3>
      <div class="space-y-3 mb-5">
        <div class="flex items-baseline justify-between text-sm sm:text-base">
          <span class="text-navy-700">Cartilha "Síndico Inteligente"</span>
          <span class="font-bold text-navy-900">R$ 57</span>
        </div>
        <div class="flex items-baseline justify-between text-sm sm:text-base">
          <span class="text-navy-700">Checklist 4 Pilares</span>
          <span class="font-bold text-navy-900">R$ 87</span>
        </div>
        <div class="flex items-baseline justify-between text-sm sm:text-base">
          <span class="text-navy-700">Guia de Contingência</span>
          <span class="font-bold text-navy-900">R$ 53</span>
        </div>
        <div class="flex items-baseline justify-between text-sm sm:text-base">
          <span class="text-navy-700">Bônus: Comunidade de Síndicos</span>
          <span class="font-bold text-navy-900">R$ 90</span>
        </div>
        <div class="border-t border-navy-200 pt-3 flex items-baseline justify-between">
          <span class="font-display font-bold text-navy-900">Total</span>
          <span class="font-display font-bold text-navy-900 line-through">R$ 287</span>
        </div>
        <div class="flex items-baseline justify-between bg-teal-50 rounded-lg p-3 -mx-2">
          <span class="font-display font-extrabold text-teal-700 text-lg">Você paga hoje</span>
          <span class="font-display font-extrabold text-teal-700 text-2xl sm:text-3xl">R$ 37</span>
        </div>
      </div>
      <div class="text-center">
        <CTAButton size="lg" fullWidth={true} />
      </div>
    </div>
  </div>
</section>
