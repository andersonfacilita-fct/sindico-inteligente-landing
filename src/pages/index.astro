  (function () {
    var STORAGE_KEY = 'si_countdown_end';
    var DURATION_MS = 3 * 24 * 60 * 60 * 1000; // 3 dias
    var endTime;

    try {
      var stored = localStorage.getItem(STORAGE_KEY);
      if (stored) {
        endTime = parseInt(stored, 10);
        if (isNaN(endTime) || endTime - Date.now() > DURATION_MS + 60000) {
          endTime = Date.now() + DURATION_MS;
          localStorage.setItem(STORAGE_KEY, String(endTime));
        }
      } else {
        endTime = Date.now() + DURATION_MS;
        localStorage.setItem(STORAGE_KEY, String(endTime));
      }
    } catch (e) {
      endTime = Date.now() + DURATION_MS;
    }

    function pad(n) { return String(n).padStart(2, '0'); }

    function update() {
      var now = Date.now();
      var diff = endTime - now;
      if (diff <= 0) {
        // Reset evergreen — recomeça mais 3 dias
        endTime = Date.now() + DURATION_MS;
        try { localStorage.setItem(STORAGE_KEY, String(endTime)); } catch (e) {}
        diff = DURATION_MS;
      }
      var d = Math.floor(diff / (1000 * 60 * 60 * 24));
      var h = Math.floor((diff / (1000 * 60 * 60)) % 24);
      var m = Math.floor((diff / (1000 * 60)) % 60);
      var s = Math.floor((diff / 1000) % 60);

      document.querySelectorAll('[data-countdown]').forEach(function (root) {
        var setUnit = function (unit, val) {
          root.querySelectorAll('[data-unit="' + unit + '"]').forEach(function (el) {
            el.textContent = pad(val);
          });
        };
        setUnit('days', d);
        setUnit('hours', h);
        setUnit('minutes', m);
        setUnit('seconds', s);
      });
    }

    update();
    setInterval(update, 1000);
  })();
